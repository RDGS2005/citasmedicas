<AnchorPane prefHeight="530.0" prefWidth="811.0" stylesheets="@../../css/registrarMedico.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appointmentsApp.controllers.admin.registrarMedicoController">
