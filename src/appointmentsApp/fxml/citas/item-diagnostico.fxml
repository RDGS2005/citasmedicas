<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="160.0" prefWidth="378.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appointmentsApp.controllers.citas.diagnosticarCitaController">

    <children>

        <!-- Columna con la información de la cita -->
        <VBox fx:id="infoBox" spacing="5">
            <children>

                <Label fx:id="lblIdCita" text="ID Cita:" />
                <Label fx:id="lblEspecialidad" text="Especialidad:" />
                <Label fx:id="lblDoctor" text="Doctor:" />
                <Label fx:id="lblFecha" text="Fecha:" />
                <Label fx:id="lblHora" text="Hora:" />

            </children>
        </VBox>

        <!-- Columna con los botones -->
        <VBox alignment="CENTER_RIGHT" spacing="10">
            <children>

                <Button fx:id="btnReagendar" prefWidth="120" text="Diagnosticar" />

            </children>
        </VBox>

    </children>

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

</HBox>
