<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ESTE ITEM SE USA PARA REPRESENTAR LAS CITAS PENDIENTES DEL USUARIO PARA REAGENDARLAS -->

<HBox prefHeight="160.0" prefWidth="441.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appointmentsApp.controllers.citas.citasPendientesPacienteItemController">

    <children>

        <!-- Columna con la información de la cita -->
        <VBox fx:id="infoBox" prefHeight="130.0" prefWidth="239.0" spacing="5">
            <children>
            <HBox prefHeight="14.0" prefWidth="239.0">
               <children>
                      <Label fx:id="lblIdCita" text="ID Cita:">
                     <HBox.margin>
                        <Insets right="25.0" />
                     </HBox.margin>
                  </Label>
                  <Label fx:id="lblIdResult" text="Aqui va el ID" />
               </children>
            </HBox>
                <Label fx:id="lblEspecialidad" text="Especialidad:" />
                <Label fx:id="lblDoctor" text="Doctor:" />
                <Label fx:id="lblFecha" text="Fecha:" />
                <Label fx:id="lblHora" text="Hora:" />
            </children>
        </VBox>

        <!-- Columna con los botones -->
        <VBox fx:id="buttonBox" alignment="CENTER_RIGHT" spacing="10">
            <children>

                <Button fx:id="btnReagendar" onAction="#reagendarCita" prefWidth="120" text="Reagendar" />
                <Button fx:id="btnCancelar" onAction="#cancelarCita" prefWidth="120" text="Cancelar" />

            </children>
        </VBox>

    </children>

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

</HBox>
