<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ESTE ITEM SE USA PARA REPRESENTAR LAS CITAS COMPLETADAS DE UN USUARIO PARA MOSTRARLAS -->

<HBox prefHeight="248.0" prefWidth="378.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appointmentsApp.controllers.citas.citasCompletadasItemController">

    <children>

        <!-- Columna con la información de la cita -->
        <VBox fx:id="infoBox" prefHeight="286.0" prefWidth="358.0" spacing="5">
            <children>

                <Label fx:id="lblIdCita" text="ID Cita:" />
                <Label fx:id="lblEspecialidad" text="Especialidad:" />
                <Label fx:id="lblDoctor" text="Doctor:" />
                <Label fx:id="lblFecha" text="Fecha:" />
                <Label fx:id="lblSintomas" text="Sintomas" />
                <Label fx:id="lblMedicina" prefHeight="4.0" prefWidth="348.0" text="Medicina" wrapText="true" />
                <Label fx:id="lblTratamiento" text="Tratamiento:" />


            </children>
        </VBox>


    </children>

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

</HBox>
