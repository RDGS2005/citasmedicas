<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ESTE ITEM SE USA PARA REPRESENTAR LAS CITAS PENDIENTES DEL USUARIO PARA REAGENDARLAS -->

<HBox prefHeight="187.0" prefWidth="444.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appointmentsApp.controllers.admin.item2PacienteController">

    <children>

        <!-- Columna con la información de la cita -->
        <VBox fx:id="infoBox" prefHeight="157.0" prefWidth="242.0" spacing="5">
            <children>

                <Label fx:id="lblIdPaciente" text="ID Paciente:" />
                <Label fx:id="lblCedula" text="Cedula:" />
                <Label fx:id="lblNombres" text="Nombres:" />
                <Label fx:id="lblApellidos" text="Apellidos:" />
                <Label fx:id="lblCorreo" text="Correo:" />
                <Label fx:id="lblTelefono" text="Telefono:" />
            </children>
        </VBox>


    </children>

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

</HBox>
