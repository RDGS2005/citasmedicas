<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ESTE ITEM SE USA PARA REPRESENTAR LAS CITAS PENDIENTES DEL USUARIO PARA REAGENDARLAS -->

<HBox prefHeight="160.0" prefWidth="441.0" spacing="20" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appointmentsApp.controllers.admin.item2MedicoController">

    <children>

        <!-- Columna con la información de la cita -->
        <VBox fx:id="infoBox" prefHeight="130.0" prefWidth="248.0" spacing="5">
            <children>

                <Label fx:id="lblIdMedico" text="ID Cita: "/>
                <Label fx:id="lblCedula" text="Cedula:" />
                <Label fx:id="lblNombre" text="Nombres:" />
                <Label fx:id="lblApellido" text="Apellido:" />
                <Label fx:id="lblEspecialidad" text="Especialidad:" />

            </children>
        </VBox>

    </children>

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

</HBox>
